# Public/non-secret application settings
APP_BASE_URL=http://localhost:3000
APP_ENV=development
LOG_LEVEL=debug

# Auth0 placeholders only — never commit real values
AUTH0_DOMAIN=your-tenant-region.auth0.com
AUTH0_CLIENT_ID=replace-with-client-id
AUTH0_CLIENT_SECRET=replace-with-client-secret
AUTH0_SECRET=replace-with-random-session-secret

# Neon placeholder only — never commit a real connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
